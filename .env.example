# =============================================================================
# TaskFlow — Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit a real .env file to version control.
# All values in this file are placeholders. Do NOT use these in production.
#
# Required variables are marked [REQUIRED].
# Optional variables are marked [OPTIONAL] — the application has safe defaults.
# =============================================================================


# =============================================================================
# APPLICATION SECURITY
# =============================================================================

# [REQUIRED] A long, random, unpredictable string used to sign session cookies
# and CSRF tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be unique per deployment. NEVER reuse or commit the real value.
SECRET_KEY=replace-with-a-long-random-secret-key


# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# [OPTIONAL] Production Database URL (PostgreSQL on Render, Supabase, Neon, etc.)
# If left unset, TaskFlow automatically uses a local SQLite database in instance/taskflow.db.
# Example: postgresql://user:password@hostname.render.com/database_name
# DATABASE_URL=postgresql://user:password@hostname.render.com/database_name


# =============================================================================
# APPLICATION BASE URL
# =============================================================================

# [OPTIONAL] Public URL of your deployed application (used for external links).
# If unset, the application dynamically resolves the base URL from the incoming request.
# Example: https://taskflow.onrender.com
# APP_BASE_URL=https://your-production-app.onrender.com


# =============================================================================
# GITHUB OAUTH (Optional — enables "Sign in with GitHub")
# =============================================================================

# [OPTIONAL] Register a GitHub OAuth App at:
# https://github.com/settings/developers
# Set the Authorization callback URL to:
#   http://127.0.0.1:5000/login/github/callback   (development)
#   https://yourdomain.com/login/github/callback   (production)
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret


# =============================================================================
# GOOGLE OAUTH (Optional — enables "Sign in with Google")
# =============================================================================

# [OPTIONAL] Create a project and OAuth 2.0 credentials in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Set the Authorised redirect URI to:
#   http://127.0.0.1:5000/login/google/callback   (development)
#   https://yourdomain.com/login/google/callback   (production)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret


# =============================================================================
# SMTP EMAIL CONFIGURATION (Optional — enables real email delivery)
# =============================================================================
# Without these, TaskFlow falls back to printing email content to the
# development console (stdout). This is safe and useful for local testing.

# [OPTIONAL] SMTP server hostname (e.g., smtp.gmail.com)
MAIL_SERVER=smtp.gmail.com

# [OPTIONAL] SMTP port — 587 for STARTTLS (default), 465 for SSL/TLS
MAIL_PORT=587

# [OPTIONAL] Enable STARTTLS — true (default) or false
MAIL_USE_TLS=true

# [OPTIONAL] SMTP authentication username (typically your email address)
MAIL_USERNAME=your-email-address@gmail.com

# [OPTIONAL] SMTP authentication password (for Gmail, use a 16-character App Password)
MAIL_PASSWORD=your-16-char-app-password

# [OPTIONAL] The From address shown in outgoing emails
MAIL_DEFAULT_SENDER=your-email-address@gmail.com
